# Copia este archivo como .env.local para trabajar en tu computadora.
# En producción, estas variables se cargan en Vercel (Settings → Environment Variables).
# Nunca subas a git un archivo con las claves reales.

# --- Supabase (ya existentes) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Formulario de contacto: SMTP2GO (solo servidor, secreto) ---
# Llave de API (SMTP2GO → Sending → API Keys), con permiso para /email/send
SMTP2GO_API_KEY=
# Remitente: una dirección del dominio verificado en SMTP2GO (no necesita ser un buzón real)
CONTACT_FROM_EMAIL=no-reply@ligakiniela.com.ve
# Buzón que recibe los mensajes
CONTACT_TO_EMAIL=contacto@ligakiniela.com.ve

# --- Formulario de contacto: Cloudflare Turnstile (captcha) ---
# Clave pública (va al navegador)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clave secreta (solo servidor)
TURNSTILE_SECRET_KEY=

# En desarrollo local, si dejas vacías las claves de Turnstile y SMTP2GO, se usan las claves de prueba
# de Cloudflare y el envío se simula (no sale ningún correo). En producción, sin claves el formulario no envía.
